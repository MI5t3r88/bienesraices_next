# Base de datos (SQLite en desarrollo; cambiar a Postgres en produccion)
DATABASE_URL="file:./dev.db"

# Auth.js - generar con: npx auth secret
AUTH_SECRET=""

# Credenciales del usuario administrador que crea el seed
ADMIN_EMAIL="admin@bienesraices.test"
ADMIN_PASSWORD="cambia-esta-clave"

# Envio de correo del formulario de contacto (opcional).
# Sin esta clave, el mensaje se guarda en la base de datos y se
# registra en consola: el formulario sigue funcionando en local.
RESEND_API_KEY=""
CONTACTO_EMAIL_DESTINO="admin@bienesraices.test"

# URL publica del sitio, usada por sitemap.xml y robots.txt
SITE_URL="http://localhost:3000"
